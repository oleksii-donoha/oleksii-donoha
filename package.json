{
  "name": "@oleksii-donoha/rds-port-forward",
  "version": "1.0.4",
  "description": "A streamlined way to forward AWS RDS ports locally for ECS-based applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksii-donoha/oleksii-donoha"
  },
  "keywords": ["aws", "rds", "ecs", "port forwarding"],
  "engines": { "node": ">=22" },
  "os": ["darwin", "linux"],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": { "rds-port-forward": "./dist/main.js" },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": ["dist", "!**/*.tsbuildinfo"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.799.0",
    "@inquirer/prompts": "^7.5.0",
    "fuse.js": "^7.1.0",
    "tslib": "^2.3.0",
    "winston": "^3.17.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^22.15.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
