{
  "name": "@oleksii-donoha/rds-port-forward",
  "version": "2.0.0",
  "description": "A streamlined way to forward AWS RDS ports locally for ECS-based applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksii-donoha/oleksii-donoha"
  },
  "keywords": [
    "aws",
    "rds",
    "ecs",
    "port forwarding"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "rds-port-forward": "./dist/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.799.0",
    "@inquirer/prompts": "8.7.0",
    "fuse.js": "^7.1.0",
    "tslib": "^2.3.0",
    "winston": "^3.17.0",
    "yargs": "18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
